# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
SERVICE_ROL_KEY=your_supabase_service_role_key

# Google Maps API
MAPS_API_KEY=your_google_maps_api_key

# Mercado Pago Configuration (Simplified Integration)
# IMPORTANT: All payments go to YOUR Mercado Pago account
# Get your credentials from: https://www.mercadopago.com.co/developers/panel/app
MP_ACCESS_TOKEN=your_mercadopago_access_token
MP_PUBLIC_KEY=your_mercadopago_public_key

# Webhook Configuration
# Secret for validating webhook signatures (optional but recommended for production)
MP_WEBHOOK_SECRET=your_webhook_secret

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Platform Configuration
DEFAULT_COMMISSION_PERCENTAGE=10
REFUND_DEADLINE_HOURS=24

# Email Configuration (future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_email_password
